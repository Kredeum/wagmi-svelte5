{
  "name": "@kredeum/wagmi-svelte5",
  "version": "0.1.7",
  "type": "module",
  "description": "Svelte5 Web3 library based on Wagmi",
  "keywords": [
    "svelte",
    "svelte5",
    "wagmi",
    "web3",
    "typescript"
  ],
  "homepage": "https://github.com/kredeum/wagmi-svelte5",
  "license": "MIT",
  "author": "zapaz.eth <zapaz@kredeum.com> (http://labs.kredeum.com/)",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/wagmi/index.d.ts",
      "svelte": "./dist/wagmi/index.js"
    }
  },
  "svelte": "./dist/wagmi/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": "^22",
    "pnpm": "^10"
  },
  "scripts": {
    "all": "pnpm run setup && pnpm run format && pnpm run check && pnpm run build && pnpm run dev",
    "clean": "rm -rf node_modules .pnpm-lock.yaml .svelte-kit dist",
    "setup": "pnpm run clean && pnpm install",
    "format": "prettier --write --list-different .",
    "check": "prettier --check . && eslint . && pnpm run sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "dev": "vite dev",
    "start": "vite dev",
    "preview": "vite preview",
    "package": "pnpm run sync && svelte-package && publint",
    "sync": "svelte-kit sync",
    "prepublishOnly": "pnpm package",
    "check:watch": "pnpm run sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint ."
  },
  "devDependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.31.0",
    "@metamask/sdk": "^0.31.5",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.25.2",
    "@sveltejs/package": "^2.4.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/node": "^22.16.5",
    "@wagmi/connectors": "^5.9.0",
    "@wagmi/core": "^2.18.0",
    "@walletconnect/ethereum-provider": "^2.21.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-svelte": "^2.46.1",
    "esm-env": "^1.2.2",
    "globals": "^15.15.0",
    "happy-dom": "^16.8.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "publint": "^0.2.12",
    "svelte": "^5.36.15",
    "svelte-check": "^4.3.0",
    "svelte-hero-icons": "^5.2.0",
    "svelte-hot-french-toast": "^1.0.0",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "viem": "^2.33.0",
    "vite": "^5.4.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "esbuild",
      "keccak",
      "utf-8-validate"
    ]
  }
}
